# Google Generative AI (Gemini) API Key
# Used in app_with_llm.py and app_arabic.py for generating accident reports
GOOGLE_API_KEY=your_google_api_key_here

# Roboflow API Key
# Used in Jupyter Notebooks for downloading datasets
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Application Configuration Overrides (Optional - defaults provided in config.py)
# MODEL_PATH=best.pt
# INJURY_MODEL_PATH=injury.pt
# CONFIDENCE_THRESHOLD=0.72
# INJURY_CONFIDENCE_THRESHOLD=0.72
# DEVICE=cpu # cuda:0, mps, or cpu (auto-detected if not set)
# GEMINI_MODEL_NAME=gemini-2.5-flash
# REPORTS_DIR=reports
# REPORT_IMAGES_DIR=report_images
# TEMP_DIR=temp
# COOLDOWN_SECONDS=5.0

# Automated Emergency Dispatch Alerts (Optional)
# ALERTS_ENABLED=true
# ALERTS_DRY_RUN=false

# Telegram Bot Alert Backend
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-1001234567890

# SMTP Email Alert Backend
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=dispatch@example.com
# SMTP_PASSWORD=your_smtp_app_password
# SMTP_FROM=alerts@acs.local
# SMTP_TO=emergency-response@city.gov,tow@city.gov
# SMTP_USE_TLS=true
