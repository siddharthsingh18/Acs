  "components": {
    "schemas": {
      "AlertSettingsResponse": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run"
          },
          "channels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Channels"
          },
          "channel_status": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/ChannelStatusInfo"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel Status",
            "description": "Configuration readiness per channel without exposing secrets"
          }
        },
        "type": "object",
        "required": [
          "enabled",
          "dry_run",
          "channels"
        ],
        "title": "AlertSettingsResponse",
        "description": "Current emergency alert system configuration."
      },
      "AlertSettingsUpdateRequest": {
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          },
          "dry_run": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dry Run"
          },
          "channels": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channels"
          },
          "model_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Path"
          },
          "confidence_threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence Threshold"
          },
          "cooldown_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cooldown Seconds"
          }
        },
        "type": "object",
        "title": "AlertSettingsUpdateRequest",
        "description": "Payload to update emergency alert configuration."
      },
      "AlertTestRequest": {
        "properties": {
          "dry_run": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dry Run",
            "default": false
          },
          "lang": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lang",
            "default": "en"
          },
          "channels": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channels"
          }
        },
        "type": "object",
        "title": "AlertTestRequest",
        "description": "Payload to trigger test alert."
      },
      "AlertTestResponse": {
        "properties": {
          "results": {
            "additionalProperties": true,
            "type": "object",
            "title": "Results"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "results",
          "message"
        ],
        "title": "AlertTestResponse",
        "description": "Delivery status results for test alert."
      },
      "ChannelStatusInfo": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured",
            "description": "True if all required credentials are set in environment"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Human-readable configuration state"
          }
        },
        "type": "object",
        "required": [
          "configured",
          "description"
        ],
        "title": "ChannelStatusInfo",
        "description": "Configuration status for an alert channel without disclosing credentials."
      },
      "ClassItem": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Raw class label name in YOLO model"
          },
          "name_ar": {
            "type": "string",
            "title": "Name Ar",
            "description": "Localized Arabic class name"
          },
          "is_accident": {
            "type": "boolean",
            "title": "Is Accident",
            "description": "True if designated as an accident class, False for normal traffic"
          }
        },
        "type": "object",
        "required": [
          "name",
          "name_ar",
          "is_accident"
        ],
        "title": "ClassItem",
        "description": "Model class item with localized translation and collision designation."
      },
      "ConfigDefaults": {
        "properties": {
          "model_path": {
            "type": "string",
            "title": "Model Path",
            "description": "Default primary YOLO weights file"
          },
          "injury_model_path": {
            "type": "string",
            "title": "Injury Model Path",
            "description": "Configured secondary injury model file"
          },
          "injury_model_available": {
            "type": "boolean",
            "title": "Injury Model Available",
            "description": "True if injury model file exists on disk"
          },
          "confidence_threshold": {
            "type": "number",
            "title": "Confidence Threshold",
            "description": "Detection confidence threshold"
          },
          "injury_confidence_threshold": {
            "type": "number",
            "title": "Injury Confidence Threshold",
            "description": "Injury detection threshold"
          },
          "cooldown_seconds": {
            "type": "number",
            "title": "Cooldown Seconds",
            "description": "Cooldown delay between incidents in seconds"
          },
          "gemini_model_name": {
            "type": "string",
            "title": "Gemini Model Name",
            "description": "Gemini multimodal model name"
          },
          "alerts_enabled": {
            "type": "boolean",
            "title": "Alerts Enabled",
            "description": "Whether emergency alert dispatch is active"
          },
          "alerts_dry_run": {
            "type": "boolean",
            "title": "Alerts Dry Run",
            "description": "Whether alert dispatch is in simulation mode"
          },
          "reports_dir": {
            "type": "string",
            "title": "Reports Dir",
            "description": "Directory storing incident CSV reports"
          },
          "report_images_dir": {
            "type": "string",
            "title": "Report Images Dir",
            "description": "Directory storing incident keyframes"
          },
          "temp_dir": {
            "type": "string",
            "title": "Temp Dir",
            "description": "Directory storing temporary uploads"
          }
        },
        "type": "object",
        "required": [
          "model_path",
          "injury_model_path",
          "injury_model_available",
          "confidence_threshold",
          "injury_confidence_threshold",
          "cooldown_seconds",
          "gemini_model_name",
          "alerts_enabled",
          "alerts_dry_run",
          "reports_dir",
          "report_images_dir",
          "temp_dir"
