    "/api/incidents": {
      "get": {
        "tags": [
          "Incidents"
        ],
        "summary": "List Incidents Endpoint",
        "description": "Returns paginated, filtered, and sorted incidents list.",
        "operationId": "list_incidents_endpoint_api_incidents_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "1-based page number",
              "default": 1,
              "title": "Page"
            },
            "description": "1-based page number"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Items per page",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Items per page"
          },
          {
            "name": "class",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by collision class",
              "title": "Class"
            },
            "description": "Filter by collision class"
          },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter incidents starting on/after date",
              "title": "Start Date"
            },
            "description": "Filter incidents starting on/after date"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter incidents starting on/before date",
              "title": "End Date"
            },
            "description": "Filter incidents starting on/before date"
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by severity ('low', 'medium', 'high')",
              "title": "Severity"
            },
            "description": "Filter by severity ('low', 'medium', 'high')"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by review status ('pending', 'approved', 'rejected', 'dispatched')",
              "title": "Status"
            },
            "description": "Filter by review status ('pending', 'approved', 'rejected', 'dispatched')"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Field to sort by ('created_at', 'start_timestamp', 'max_confidence', 'class_name')",
              "default": "created_at",
              "title": "Sort By"
            },
            "description": "Field to sort by ('created_at', 'start_timestamp', 'max_confidence', 'class_name')"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(asc|desc)$",
              "description": "Sort order ('asc' or 'desc')",
              "default": "desc",
              "title": "Order"
            },
            "description": "Sort order ('asc' or 'desc')"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
