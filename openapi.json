    "/api/jobs": {
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Create Job Endpoint",
        "description": "Creates and starts a background video analysis job.\n\nSupports:\n- JSON payload: {\"source\": \"sample\", \"model_name\": \"best.pt\", \"confidence\": 0.5, \"use_injury_model\": false}\n- Multipart form: file upload with optional fields 'source', 'model_name', 'confidence', 'use_injury_model'\n\nRaises:\n    HTTPException 409: If an analysis job is already active.\n    HTTPException 400: If video source is invalid or missing.",
        "operationId": "create_job_endpoint_api_jobs_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreatedResponse"
                }
              }
            }
          }
        }
      }
    },
